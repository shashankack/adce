{
  "name": "adce",
  "version": "0.1.0",
  "description": "Artifact-Driven Context Engine — CLI for AI coding agents",
  "keywords": [
    "adce",
    "context-engineering",
    "llm",
    "ai-coding",
    "cli"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "adce": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashankack/adce.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@adce/core": "workspace:*",
    "@adce/shared": "workspace:*",
    "commander": "^15.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
