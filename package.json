{
  "name": "adce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "test:core": "pnpm --filter @adce/core test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @adce/cli dev",
    "bench:analyze": "tsx benchmarks/run-analyze-benchmark.ts",
    "reset:relationships": "tsx scripts/reset-relationships.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
